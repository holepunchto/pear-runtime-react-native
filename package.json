{
  "name": "pear-runtime-react-native",
  "version": "0.0.0",
  "description": "Enables OTA updates with pear-runtime in react-native mobile apps",
  "main": "index.js",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./metro-config": "./metro.js",
    "./plugin": "./plugin/pearOta.js"
  },
  "files": [
    "package.json",
    "index.js",
    "index.d.ts",
    "metro.js",
    "lib/ota-templates.js",
    "plugin/pearOta.js"
  ],
  "scripts": {
    "format": "prettier . --write",
    "test": "prettier . --check && lunte && brittle-bare test/index.js",
    "lint": "lunte"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/pear-runtime-react-native.git"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/pear-runtime-react-native/issues"
  },
  "homepage": "https://github.com/holepunchto/pear-runtime-react-native",
  "devDependencies": {
    "brittle": "^3.19.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "peerDependencies": {
    "react-native-bare-kit": "*",
    "react-native-fs": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "@react-native/metro-config": {
      "optional": true
    }
  }
}
